{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(node obs.mjs *)"],
    "deny": ["Edit(./corpus/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-corpus.ts"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "extractor",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.ts"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "extractor",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-subagent.ts"], "timeout": 120 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.ts"], "timeout": 10 }
        ]
      }
    ]
  }
}
