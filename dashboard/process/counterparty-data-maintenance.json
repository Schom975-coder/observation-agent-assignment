  "synthesis": {
    "description": "A coordinator circulates a monthly notice of counterparty name changes and mergers, first as an initial notice and then as the final list for the month. The reference data team announces when it will apply the changes in the system, and risk staff forward the list onward and remind their groups to use it.",
    "steps": [
      "Collect the month's counterparty name changes, mergers and inactivations.",
      "Send the initial merger and name change notice for the month.",
      "Issue the final list for the month once changes are confirmed.",
      "Announce when the changes will be applied in the reference system and apply them.",
      "Forward the list to desk staff and remind them to use the updated names."
    ],
    "approach": "Keep the counterparty change list in one shared register that feeds the reference system, and generate the initial and final monthly notices from it, with a scheduled update window stated in each notice.",
    "rationale": "The work is a recurring list moving from initial to final and then into the system; a standard list layout reduces retyping and makes it clear which version desks should use.",
    "artifact_type": "template"
  },
