# Read-only, Windows-safe copy of the corpus for browsing (see CLAUDE.md). Never cited, never read by code.
corpus-view/

node_modules/

# Corpus text repackaged for the model stages (batch files, the taxonomy digest, the gold sample);
# rebuilt in seconds, never committed.
out/batches/
out/taxonomy-digest.md
out/gold-sample.md

# The merge input and the synthesis group inputs carry corpus text too (names, subjects, quotes);
# rollup and merge rebuild them in seconds. The group sidecars (ids, no quotes) are committed.
out/merge-input.md
out/synthesis/input/*.md

# Run-time state with no meaning after the run (ARCHITECTURE.md 6.17): the taxonomist's and the
# merger's unchecked proposals, fix-round problem lists (they quote model output), the active-run
# marker, the run claim, agent bindings, the Stop hook's repeat guard, the log of hook events
# outside a run, and the ledger's locks and half-written files.
out/taxonomy-proposed.json
out/merge-proposed.json
out/ledger/claim.json
out/fix/
out/ledger/run.json
out/ledger/agents/
out/ledger/stop-gate.json
out/runs/adhoc.jsonl
*.lock
*.lock.takeover
*.tmp

# The dashboard server's state while it runs (pid, port, URL): meaningless after it stops.
out/dashboard/.server.json

# Git Bash crash dumps on Windows.
*.stackdump

# Raw stream from headless runs: carries absolute paths from prompts.
out/runs/stream.jsonl

# The built project site (node site/build.ts) and the folder it is built in before it moves into
# place; published to the gh-pages branch by node site/publish.ts.
site/dist/
site/dist.building/
