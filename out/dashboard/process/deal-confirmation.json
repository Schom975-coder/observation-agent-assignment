  "synthesis": {
    "description": "Written confirmations of gas purchases and sales are executed and passed on. A marketer executes a sales confirm and sends a copy to colleagues, counterparties ask for copies to be faxed or forwarded, and counterparties chase confirmations for months they never received. Senders are not always sure how the confirmation reaches the people who need it.",
    "steps": [
      "A gas purchase or sale is agreed with a counterparty.",
      "The confirmation is prepared and executed.",
      "A copy is sent to internal colleagues and to the counterparty.",
      "Missing confirmations are requested by the counterparty and resent."
    ],
    "approach": "Generate confirmations from the deal record when a deal is entered, send them to the counterparty and a fixed internal distribution automatically, and track which deals still lack a confirmation so gaps are caught before the counterparty asks.",
    "rationale": "The problems shown are about routing: who gets the confirm and whether it was ever sent. A short written procedure naming the distribution and the check for unconfirmed deals addresses both right away.",
    "artifact_type": "sop"
  },
  "formula": {
    "counted": "5 occ over 676 d = 22.21 mo; email: 3 short x2 + 0 medium x6 + 0 long x15 + 0 fwd x2 + 0 chaser x3 + 7 read x1 = 13.00 min = 0.59 min/mo; automatable 60/40/30/80/100/50% = 7.10 min = 0.32 min/mo",
    "estimated": "5.00 occ x 10 min/occ (estimate, mid of 5-25, basis inferred, 4 quotes from 4 occurrences) = 50.00 min = 2.25 min/mo; automatable 60% (estimate) = 1.35 min/mo; at the low end 5 min/occ = $1.41/mo, at the high end 25 min/occ = $5.24/mo (the row's automatable total)",
    "total": "today 2.84 min/mo = 0.05 h/mo = $4.03/mo (email 0.59 min/mo = $0.84 + work 2.25 min/mo = $3.19); automatable 1.67 min/mo = 0.03 h/mo = $2.36/mo (counted email 0.32 min/mo = $0.45 + estimated work 1.35 min/mo = $1.91)"
