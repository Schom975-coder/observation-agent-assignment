  "synthesis": {
    "description": "The real-time desk sends the daily EES and El Paso Electric models and hourly data files to customers and settlements, forwarding them on and keeping the recipient list current. Desk staff also reconcile the El Paso model against the internal CARP report each month and complete a monthly EPE reconciliation sheet.",
    "steps": [
      "The desk prepares the daily real-time model for EES or EPE for the prior day.",
      "The model is emailed to the distribution list and forwarded where needed.",
      "Recipients are added or removed from the list when staff change.",
      "Hourly data are added to the daily mail-out on request.",
      "The real-time model is reconciled against the CARP report and the monthly reconciliation sheet is completed."
    ],
    "approach": "Generate and send the daily model from the scheduling system to a maintained distribution list, and run an automatic comparison of the real-time model against the CARP report that flags only variances for review.",
    "rationale": "The work is a fixed daily send and a periodic reconciliation. A short procedure covering the file, the list owner and the reconciliation check keeps it consistent, and most of the send and comparison can be scripted.",
    "artifact_type": "sop"
  },
