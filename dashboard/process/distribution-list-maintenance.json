  "synthesis": {
    "description": "Staff ask report senders to add a group address such as DL-Portland Shift to a distribution, or to correct how a name appears so mail is received. The list owner sometimes asks for the member names, which are then supplied. Requests also gather contact details for new list members.",
    "steps": [
      "Notice a missing recipient or a wrong name on a distribution list.",
      "Ask the list owner to add, remove or correct the entry.",
      "Supply the member names or contact details the owner asks for.",
      "List owner updates the list."
    ],
    "approach": "Have report senders address shared group lists maintained from the directory rather than personal lists, so name changes and team membership flow through automatically, with a standard request message for adding a list.",
    "rationale": "Each round is a short request to add or correct a recipient. A reusable request stating the list, the change and the members removes the back-and-forth over who belongs on the list.",
    "artifact_type": "email_template"
  },
