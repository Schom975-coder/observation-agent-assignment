  "synthesis": {
    "description": "Staff and managers email HR or an assistant to change an employee's record or pay: setting up operating companies or system access for new people, adding people left off a roster, switching a parking benefit to a bus pass, stopping a charitable payroll deduction, or confirming whether departed employees get an extra payment. HR in turn sends surveys and membership questionnaires to fill out and return by a stated deadline. Each request is looked up, the record changed or the answer confirmed, and the requester told.",
    "steps": [
      "An employee or manager emails a record, pay or benefit change, or HR sends out a form to complete.",
      "The handler looks up the employee's current record or the policy in question.",
      "The handler enters the change or confirms the answer with HR or payroll.",
      "Missing people or access are added to the roster or system.",
      "The requester is told the result, and completed forms are collected back."
    ],
    "approach": "Route record and benefit changes through one request form with fields for employee, change type and effective date, feeding a tracked queue; keep roster checks against the HR system as a generated list sent only to each person's actual manager.",
    "rationale": "The requests are short and varied but share the same fields; a standard form removes the back-and-forth over missing people and misrouted roster checks, and gives the requester a status to look at instead of asking.",
    "artifact_type": "template"
  },
  "formula": {
    "counted": "10 occ over 737 d = 24.21 mo; email: 6 short x2 + 1 medium x6 + 0 long x15 + 3 fwd x2 + 1 chaser x3 + 20 read x1 = 47.00 min = 1.94 min/mo; automatable 60/40/30/80/100/50% = 27.40 min = 1.13 min/mo",
    "estimated": "10.00 occ x 15 min/occ (estimate, mid of 5-30, basis observed, 6 quotes from 6 occurrences) = 150.00 min = 6.20 min/mo; automatable 30% (estimate) = 1.86 min/mo; at the low end 5 min/occ = $2.48/mo, at the high end 30 min/occ = $6.87/mo (the row's automatable total)",
    "total": "today 8.14 min/mo = 0.14 h/mo = $11.53/mo (email 1.94 min/mo = $2.75 + work 6.20 min/mo = $8.78); automatable 2.99 min/mo = 0.05 h/mo = $4.24/mo (counted email 1.13 min/mo = $1.60 + estimated work 1.86 min/mo = $2.64)"
  },
